# Only source inputs required by the bundled image enter the build context.
**
!Dockerfile
!global.json
!fastapi_backend/
!fastapi_backend/pyproject.toml
!fastapi_backend/uv.lock
!fastapi_backend/main.py
!fastapi_backend/docker-entrypoint.sh
!fastapi_backend/app/
!fastapi_backend/app/*.py
!avalonia_ui/
!avalonia_ui/WorkLogManagementSystem_UI/
!avalonia_ui/WorkLogManagementSystem_UI/Directory.Packages.props
!avalonia_ui/WorkLogManagementSystem_UI/WorkLogManagementSystem_UI/
!avalonia_ui/WorkLogManagementSystem_UI/WorkLogManagementSystem_UI/**
!avalonia_ui/WorkLogManagementSystem_UI/WorkLogManagementSystem_UI.Browser/
!avalonia_ui/WorkLogManagementSystem_UI/WorkLogManagementSystem_UI.Browser/**

# Exclusions must remain after the source exceptions above.
**/bin
**/obj
**/.git
**/.idea
**/.agents
**/.codex
**/.venv
**/__pycache__
**/.pytest_cache
**/*.py[cod]
**/.env
**/.env.*
**/*.sqlite*
**/*.db
**/*.db-*
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.tar
**/*.tar.gz
**/*.zip
